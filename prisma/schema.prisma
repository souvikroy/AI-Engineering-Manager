generator client {
  provider = "prisma-client-js"
}

// NOTE: Phase 1 keeps `provider = "sqlite"` so the running mock-data app continues to work
// during the Postgres+pgvector migration. When ready to flip to Neon:
//   1. Set DATABASE_URL to the Neon URL
//   2. Change provider to "postgresql" and add `schemas = ["app"]`
//   3. Add `@@schema("app")` to every model below
//   4. Run `npx prisma migrate dev --name postgres_app_schema`
// All models already carry workspaceId (nullable) so the migration is shape-stable.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id          String     @id
  workspaceId String?
  name        String
  mission     String
  engineers   Engineer[]
  okrs        OKR[]

  @@index([workspaceId])
}

model Engineer {
  id             String     @id
  workspaceId    String?
  name           String
  email          String?    @unique
  role           String
  level          String
  teamId         String
  team           Team       @relation(fields: [teamId], references: [id])
  joinedAt       DateTime
  slackHandle    String
  githubHandle   String
  oneOnOnes      OneOnOne[]
  ownedIncidents Incident[]

  @@index([workspaceId])
}

model OneOnOne {
  id          String   @id @default(cuid())
  workspaceId String?
  engineerId  String
  engineer    Engineer @relation(fields: [engineerId], references: [id])
  date        DateTime
  topics      String
  commitments String
  sentiment   String
  notes       String
  meetingId   String?  @unique
  meeting     Meeting? @relation("MeetingOneOnOne", fields: [meetingId], references: [id])

  @@index([workspaceId])
}

model DesignDoc {
  id          String     @id @default(cuid())
  workspaceId String?
  title       String
  author      String
  content     String
  tags        String
  status      String
  createdAt   DateTime   @default(now())
  decisions   Decision[]

  @@index([workspaceId])
}

model Decision {
  id              String     @id @default(cuid())
  workspaceId     String?
  designDocId     String?
  designDoc       DesignDoc? @relation(fields: [designDocId], references: [id])
  sourceMeetingId String?
  sourceMeeting   Meeting?   @relation("MeetingDecisions", fields: [sourceMeetingId], references: [id])
  title           String
  summary         String
  options         String
  chosen          String
  rationale       String
  tradeoffs       String
  tags            String
  createdAt       DateTime   @default(now())

  @@index([workspaceId])
}

model Incident {
  id          String       @id
  workspaceId String?
  title       String
  severity    String
  status      String
  openedAt    DateTime
  resolvedAt  DateTime?
  summary     String
  ownerId     String?
  owner       Engineer?    @relation(fields: [ownerId], references: [id])
  alerts      String
  postmortems Postmortem[]

  @@index([workspaceId])
}

model Postmortem {
  id          String   @id @default(cuid())
  workspaceId String?
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
  timeline    String
  rootCause   String
  actionItems String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model OKR {
  id          String @id
  workspaceId String?
  teamId      String
  team        Team   @relation(fields: [teamId], references: [id])
  objective   String
  keyResults  String
  progress    Float
  quarter     String
  status      String

  @@index([workspaceId])
}

model BriefSnapshot {
  id          String   @id @default(cuid())
  workspaceId String?
  date        DateTime
  content     String
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model PRReview {
  id               String    @id @default(cuid())
  workspaceId      String?
  repo             String
  prNumber         Int
  prTitle          String
  classification   String
  verdict          String
  summary          String
  workflowsRun     String
  postedCommentUrl String?
  createdAt        DateTime  @default(now())
  findings         Finding[]

  @@index([workspaceId, createdAt])
}

model Finding {
  id          String   @id @default(cuid())
  workspaceId String?
  prReviewId  String
  prReview    PRReview @relation(fields: [prReviewId], references: [id])
  ruleId      String
  workflowId  Int
  status      String
  severity    String
  issue       String   @default("")
  location    String   @default("")
  fix         String   @default("")
  evidence    String

  @@index([workspaceId])
}

model ChatSession {
  id          String   @id @default(cuid())
  workspaceId String?
  title       String
  messages    String
  pinned      Boolean  @default(false)
  // If non-null, this session is the rolling output thread for a Schedule.
  // The schedule appends a dated separator + assistant message on each fire.
  scheduleId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule    Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt])
  @@index([pinned, updatedAt])
}

// ─── Scheduled chats ─────────────────────────────────────────────────
// User schedules a prompt to fire at a regular cadence. The runtime
// (src/lib/schedule/scheduler.ts) hydrates active rows on Next.js boot,
// sets in-process timers, and appends results into the linked rolling
// ChatSession. Cron expression intentionally restricted to daily/weekly
// time-of-day patterns for now.
model Schedule {
  id            String       @id @default(cuid())
  workspaceId   String?
  name          String       // human label for sidebar / manager
  prompt        String       // the user message that fires
  // Frequency the user picked. Encoded as JSON to keep the schema
  // forward-compatible if we add weekly/specific-day later.
  // Shape: { kind: "daily" | "weekdays" | "weekly", time: "HH:MM", weekday?: 0..6 }
  cadence       String
  tz            String       @default("UTC")
  paused        Boolean      @default(false)
  // Pre-warm offset in minutes (default 10). Set to 0 to disable.
  prewarmOffsetMin Int       @default(10)
  // When true, the scheduler also sends an email (via Resend) on each fire,
  // with the assistant response inline + the artifact attached as a file.
  // Recipient comes from USER_EMAIL env (single env-wide for this build).
  notifyEmail   Boolean      @default(false)
  lastFiredAt   DateTime?
  nextFireAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  session       ChatSession?

  @@index([workspaceId, nextFireAt])
}

// ─── Meeting transcripts ─────────────────────────────────────────────
// Populated by services/context/app/ingest/meetings/* (Fireflies / Read.ai /
// Otter / Grain / tl;dv). Full transcript text lives only in rag.document;
// `ragDocumentId` is the join key for retrieval.

model Meeting {
  id                String              @id @default(cuid())
  workspaceId       String?
  provider          String
  providerMeetingId String
  title             String
  startedAt         DateTime
  durationSeconds   Int
  meetingType       String
  confidential      Boolean             @default(false)
  recordingUrl      String?
  transcriptUrl     String?
  participants      String              // JSON: [{engineerId, name, email, role}]
  ragDocumentId     String?             // mirror of rag.document UUID
  createdAt         DateTime            @default(now())
  actionItems       MeetingActionItem[]
  standupView       StandupView?
  decisions         Decision[]          @relation("MeetingDecisions")
  oneOnOne          OneOnOne?           @relation("MeetingOneOnOne")

  @@unique([provider, providerMeetingId])
  @@index([workspaceId, startedAt])
  @@index([meetingType, startedAt])
}

model MeetingActionItem {
  id                 String    @id @default(cuid())
  workspaceId        String?
  meetingId          String
  meeting            Meeting   @relation(fields: [meetingId], references: [id])
  text               String
  assigneeEngineerId String?
  dueDate            DateTime?
  status             String    @default("open") // open | done | cancelled
  source             String    @default("provider") // provider | haiku
  createdAt          DateTime  @default(now())

  @@index([assigneeEngineerId, status])
}

model StandupView {
  id          String   @id @default(cuid())
  workspaceId String?
  meetingId   String   @unique
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  date        DateTime
  engineerId  String
  yesterday   String
  today       String
  blockers    String

  @@index([date, engineerId])
}
