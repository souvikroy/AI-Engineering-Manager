// Postgres-targeted Prisma schema.
//
// This file is the *target* of `scripts/flip-to-postgres.sh`. The active
// schema today is the SQLite-targeted `schema.prisma`; the flip script swaps
// this file in once a Postgres DATABASE_URL is configured.
//
// Differences from the SQLite version:
// - provider = "postgresql"
// - schemas = ["app"]   so this Prisma surface coexists with the rag schema owned by Python
// - @@schema("app") on every model
// - everything else (workspaceId nullable + indexes) is identical

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

model Team {
  id          String     @id
  workspaceId String?
  name        String
  mission     String
  engineers   Engineer[]
  okrs        OKR[]

  @@index([workspaceId])
  @@schema("app")
}

model Engineer {
  id             String     @id
  workspaceId    String?
  name           String
  role           String
  level          String
  teamId         String
  team           Team       @relation(fields: [teamId], references: [id])
  joinedAt       DateTime
  slackHandle    String
  githubHandle   String
  oneOnOnes      OneOnOne[]
  ownedIncidents Incident[]

  @@index([workspaceId])
  @@schema("app")
}

model OneOnOne {
  id          String   @id @default(cuid())
  workspaceId String?
  engineerId  String
  engineer    Engineer @relation(fields: [engineerId], references: [id])
  date        DateTime
  topics      String
  commitments String
  sentiment   String
  notes       String

  @@index([workspaceId])
  @@schema("app")
}

model DesignDoc {
  id          String     @id @default(cuid())
  workspaceId String?
  title       String
  author      String
  content     String
  tags        String
  status      String
  createdAt   DateTime   @default(now())
  decisions   Decision[]

  @@index([workspaceId])
  @@schema("app")
}

model Decision {
  id          String     @id @default(cuid())
  workspaceId String?
  designDocId String?
  designDoc   DesignDoc? @relation(fields: [designDocId], references: [id])
  title       String
  summary     String
  options     String
  chosen      String
  rationale   String
  tradeoffs   String
  tags        String
  createdAt   DateTime   @default(now())

  @@index([workspaceId])
  @@schema("app")
}

model Incident {
  id          String       @id
  workspaceId String?
  title       String
  severity    String
  status      String
  openedAt    DateTime
  resolvedAt  DateTime?
  summary     String
  ownerId     String?
  owner       Engineer?    @relation(fields: [ownerId], references: [id])
  alerts      String
  postmortems Postmortem[]

  @@index([workspaceId])
  @@schema("app")
}

model Postmortem {
  id          String   @id @default(cuid())
  workspaceId String?
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
  timeline    String
  rootCause   String
  actionItems String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@schema("app")
}

model OKR {
  id          String  @id
  workspaceId String?
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id])
  objective   String
  keyResults  String
  progress    Float
  quarter     String
  status      String

  @@index([workspaceId])
  @@schema("app")
}

model BriefSnapshot {
  id          String   @id @default(cuid())
  workspaceId String?
  date        DateTime
  content     String
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@schema("app")
}

model PRReview {
  id               String    @id @default(cuid())
  workspaceId      String?
  repo             String
  prNumber         Int
  prTitle          String
  classification   String
  verdict          String
  summary          String
  workflowsRun     String
  postedCommentUrl String?
  createdAt        DateTime  @default(now())
  findings         Finding[]

  @@index([workspaceId, createdAt])
  @@schema("app")
}

model Finding {
  id          String   @id @default(cuid())
  workspaceId String?
  prReviewId  String
  prReview    PRReview @relation(fields: [prReviewId], references: [id])
  ruleId      String
  workflowId  Int
  status      String
  severity    String
  issue       String   @default("")
  location    String   @default("")
  fix         String   @default("")
  evidence    String

  @@index([workspaceId])
  @@schema("app")
}

model ChatSession {
  id          String   @id @default(cuid())
  workspaceId String?
  title       String
  messages    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, updatedAt])
  @@schema("app")
}
