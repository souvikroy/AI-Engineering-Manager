# Required: Anthropic API key for Claude calls
ANTHROPIC_API_KEY=sk-ant-...

# Required for PR review feature: GitHub Personal Access Token
# Scope needed: repo (read + post review comments)
GITHUB_PAT=ghp_...

# Repo to review, format owner/name (e.g. "vercel/next.js")
GITHUB_REPO=

# Optional: override the Claude model IDs (default to Opus 4.5 / Haiku 4.5)
# ANTHROPIC_MODEL_REASONING=claude-opus-4-5
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# SQLite path (default works locally)
DATABASE_URL="file:./dev.db"
