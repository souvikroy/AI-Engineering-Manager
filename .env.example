# ─── Core ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_REASONING=claude-opus-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Next.js DB. Phase 1: SQLite (current). Phase 1+: Postgres on Neon.
# Postgres example: DATABASE_URL="postgresql://aiem:aiem@localhost:5432/aiem?schema=app"
DATABASE_URL="file:./dev.db"

# Single-tenant workspace id. Multi-tenant lands in a later phase.
WORKSPACE_ID=personal

# ─── Python context engine ───────────────────────────────────────────────────
# Where the Next.js chat tools fan out to for retrieval / summary / doc.
PYTHON_CONTEXT_URL=http://localhost:8000

# Embeddings — without this, the Python service uses deterministic dev embeddings.
VOYAGE_API_KEY=

# ─── PR review (live today) ──────────────────────────────────────────────────
GITHUB_PAT=ghp_...
GITHUB_REPO=

# ─── Source integrations (wired in their respective phases) ──────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
JIRA_BASE_URL=
JIRA_PAT=
JIRA_EMAIL=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
NOTION_TOKEN=
LINEAR_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Self-monitoring ─────────────────────────────────────────────────────────
SENTRY_DSN_SELF=
LOG_LEVEL=INFO
