# =====================================================================
# Reviewer — environment template. Copy to .env and fill in.
# =====================================================================

# ---- GitHub PAT (CLI / fallback) ----
GITHUB_TOKEN=

# ---- OpenRouter ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REVIEWER_MODEL_PLANNER=qwen/qwen3-coder
REVIEWER_MODEL_HEAVY=qwen/qwen3-coder
REVIEWER_MODEL_LIGHT=qwen/qwen-2.5-coder-32b-instruct
REVIEWER_MODEL_CRITIC=qwen/qwen3-32b
REVIEWER_MODEL_EMBED=qwen/qwen3-embedding-8b

# ---- Neon Postgres ----
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
REVIEWER_DB_URL=${DATABASE_URL}

# ---- Upstash Redis (REST) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- QStash (optional) ----
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
WORKER_PUBLIC_URL=http://localhost:8000

# ---- Pinecone ----
PINECONE_API_KEY=
PINECONE_INDEX=reviewer-prod
REVIEWER_VECTOR_BACKEND=memory

# ---- Auth ----
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Fernet PAT encryption (rotate via SECONDARY) ----
FERNET_KEY=
FERNET_KEY_SECONDARY=

# ---- Internal HMAC ----
INTERNAL_HMAC_SECRET=

# ---- CORS / role ----
ALLOWED_ORIGINS=http://localhost:5173
ROLE=web

# ---- Budgets ----
REVIEWER_BUDGET_USD=10.0
REVIEWER_BUDGET_TOKENS=2000000
REVIEWER_WORK_DIR=./.reviewer
